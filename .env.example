# ============ 应用信息 ============
APP_NAME=HZX-定时唤醒
APP_VERSION=V5.3.0
DEVELOPER=IT-钟
PHONE=18072740843

# ============ 数据库 ============
# 容器内使用 db 作为主机名；本地开发改为 localhost
DATABASE_URL=postgresql+psycopg2://hzx:hzx123456@db:5432/hzx_scheduler

# ============ 时区 / 调度 ============
TIMEZONE=Asia/Shanghai
SCHEDULER_INTERVAL_SECONDS=10

# ============ 默认飞书 Webhook（可选）============
DEFAULT_WEBHOOK_URL=
DEFAULT_WEBHOOK_SECRET=

# ============ 邮件（QQ 邮箱）============
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ERROR_REPORT_EMAIL=

# ============ 备份 ============
DATA_DIR=/app/data
BACKUP_KEEP_DAYS=30

# ============ 服务 ============
HOST=0.0.0.0
PORT=6100
CORS_ORIGINS=*
